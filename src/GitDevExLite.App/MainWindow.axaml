<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDevExLite.App.ViewModels"
        xmlns:views="using:GitDevExLite.App.Views"
        x:Class="GitDevExLite.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1400" Height="860">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Open..." Click="OnOpenClick" />
        <Button Content="Clone..." Command="{Binding CloneCommand}" />
        <Menu>
          <MenuItem x:Name="RecentMenu" Header="Recent" />
          <MenuItem Header="AI">
            <MenuItem Header="Settings..." Command="{Binding ConfigureAiCommand}" />
            <MenuItem Header="Test connection" Command="{Binding TestAiConnectionCommand}" />
          </MenuItem>
          <MenuItem Header="Pull">
            <MenuItem Header="Merge" Command="{Binding SelectedTab.PullMergeCommand}" />
            <MenuItem Header="Rebase" Command="{Binding SelectedTab.PullRebaseCommand}" />
            <MenuItem Header="Fast-forward only" Command="{Binding SelectedTab.PullFastForwardCommand}" />
          </MenuItem>
          <MenuItem Header="Options">
            <MenuItem Header="Auto-fetch" ToggleType="CheckBox" IsChecked="{Binding Options.AutoFetch, Mode=TwoWay}" />
            <MenuItem Header="Prune on fetch" ToggleType="CheckBox" IsChecked="{Binding Options.PruneOnFetch, Mode=TwoWay}" />
          </MenuItem>
        </Menu>
        <Button Content="Fetch" Command="{Binding SelectedTab.FetchCommand}" />
        <Button Content="Push" Command="{Binding SelectedTab.PushCommand}" />
        <Button Content="Force push..." Command="{Binding SelectedTab.ForcePushCommand}" ToolTip.Tip="Push with --force-with-lease" />
        <Button Content="Stash..." Command="{Binding SelectedTab.StashCommand}" />
        <Button Content="Undo" Command="{Binding SelectedTab.UndoCommand}" ToolTip.Tip="Undo the last operation using the reflog" />
        <Button Content="Tools..." Command="{Binding SelectedTab.OpenToolsCommand}" ToolTip.Tip="Reflog, submodules, worktrees" />
        <Button Content="Refresh" Command="{Binding RefreshSelectedCommand}" />
        <Button Content="Checkout" Command="{Binding CheckoutSelectedCommand}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
      <Grid ColumnDefinitions="*,Auto,200,Auto">
        <Grid Grid.Column="0">
          <TextBlock Text="{Binding StatusText}" Opacity="0.7"
                     IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNull}}" />
          <TextBlock Text="{Binding SelectedTab.StatusText}" Opacity="0.7"
                     IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding SelectedTab.OperationText}" Margin="8,0" VerticalAlignment="Center"
                   IsVisible="{Binding SelectedTab.IsBusy, FallbackValue=False}" />
        <ProgressBar Grid.Column="2" Maximum="100" VerticalAlignment="Center"
                     Value="{Binding SelectedTab.ProgressPercent}"
                     IsIndeterminate="{Binding SelectedTab.ProgressIndeterminate}"
                     IsVisible="{Binding SelectedTab.IsBusy, FallbackValue=False}" />
        <Button Grid.Column="3" Content="Cancel" Margin="8,0,0,0" Padding="8,0"
                Command="{Binding SelectedTab.CancelOperationCommand}"
                IsVisible="{Binding SelectedTab.IsBusy, FallbackValue=False}" />
      </Grid>
    </Border>

    <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RepoTabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" ToolTip.Tip="{Binding RepositoryPath}" />
            <Button Content="&#x2715;" Padding="4,0" FontSize="10" Background="Transparent"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:RepoTabViewModel">
          <views:RepoView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
