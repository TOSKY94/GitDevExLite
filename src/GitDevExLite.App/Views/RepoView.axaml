<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDevExLite.App.ViewModels"
             xmlns:ctl="using:GitDevExLite.App.Controls"
             xmlns:m="using:GitDevExLite.Core.Models"
             x:Class="GitDevExLite.App.Views.RepoView"
             x:DataType="vm:RepoTabViewModel">
  <Grid ColumnDefinitions="220,Auto,*">
    <ScrollViewer Grid.Column="0">
      <StackPanel Margin="8" Spacing="4">
        <Border Background="#1E3A2A" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="10,8"
                ToolTip.Tip="Currently checked-out branch">
          <StackPanel Spacing="2">
            <TextBlock Text="CHECKED OUT" FontSize="10" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="&#x2387;" Foreground="#81C784" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentBranchLabel}" FontWeight="Bold" FontSize="14"
                         Foreground="#A5D6A7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentBranchSync}" Opacity="0.8" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Expander Header="Local" IsExpanded="True" HorizontalAlignment="Stretch">
          <ListBox ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding SelectedBranch}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:RefInfo">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="&#x2714;" Foreground="#81C784" IsVisible="{Binding IsHead}" />
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#A5D6A7" IsVisible="{Binding IsHead}" />
                  <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsHead}" Margin="18,0,0,0" />
                  <TextBlock Text="{Binding AheadBehindText}" Opacity="0.7" ToolTip.Tip="{Binding Upstream}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
        <Expander Header="Remote" HorizontalAlignment="Stretch">
          <ListBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedBranch}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:RefInfo">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
        <Expander Header="Tags" HorizontalAlignment="Stretch">
          <ListBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Push tag" Command="{Binding PushSelectedTagCommand}" />
                <MenuItem Header="Delete tag..." Command="{Binding DeleteSelectedTagCommand}" />
                <MenuItem Header="Delete tag from remote..." Command="{Binding DeleteSelectedTagFromRemoteCommand}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:RefInfo">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
        <Expander Header="Stashes" HorizontalAlignment="Stretch">
          <ListBox ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash}">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Apply" Command="{Binding ApplySelectedStashCommand}" />
                <MenuItem Header="Pop (apply and delete)" Command="{Binding PopSelectedStashCommand}" />
                <MenuItem Header="Drop..." Command="{Binding DropSelectedStashCommand}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:StashInfo">
                <TextBlock Text="{Binding Message}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
        <Expander Header="Pull requests" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ProviderSummary}" TextWrapping="Wrap" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Create PR"
                Command="{Binding CreatePullRequestCommand}"
                IsEnabled="{Binding CanCreatePullRequest}" />
              <Button Content="Sign in"
                      Command="{Binding SignInProviderCommand}"
                      IsVisible="{Binding CanSignInToProvider}" />
              <Button Content="Refresh"
                      Command="{Binding RefreshPullRequestsCommand}"
                      IsEnabled="{Binding HasHostedRepository}" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding PullRequestFilters}"
                      SelectedValue="{Binding PullRequestFilter}"
                      SelectedValueBinding="{Binding Value}"
                      Width="180">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepoTabViewModel+PullRequestFilterOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ListBox ItemsSource="{Binding PullRequests}" SelectedItem="{Binding SelectedPullRequest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:PullRequestListItem">
                  <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,2">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#2E7D32" CornerRadius="8" Padding="6,1" IsVisible="{Binding !IsDraft}">
                          <TextBlock Text="{Binding Status}" FontSize="10" Foreground="White" />
                        </Border>
                        <Border Background="#616161" CornerRadius="8" Padding="6,1" IsVisible="{Binding IsDraft}">
                          <TextBlock Text="Draft" FontSize="10" Foreground="White" />
                        </Border>
                        <TextBlock Opacity="0.65" FontSize="11" VerticalAlignment="Center">
                          <Run Text="#" /><Run Text="{Binding Number}" /><Run Text="  by " /><Run Text="{Binding Author}" />
                        </TextBlock>
                      </StackPanel>
                      <WrapPanel>
                        <Border Background="#2E7D32" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                          <TextBlock Text="{Binding SourceBranch}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                        </Border>
                        <TextBlock Text="&#x2192;" Opacity="0.6" Margin="0,0,4,0" />
                        <Border Background="#1565C0" CornerRadius="4" Padding="5,1">
                          <TextBlock Text="{Binding TargetBranch}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="4" />

    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,*">
      <!-- Search and mode toggle -->
      <StackPanel Grid.Row="0">
      <!-- Merge / rebase / cherry-pick / revert in progress -->
      <Border IsVisible="{Binding HasOperation}" Background="#33FFB74D" Padding="8,6" Margin="6,6,6,0" CornerRadius="4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Content="Continue" Command="{Binding ContinueOperationCommand}" />
            <Button Content="Skip" Command="{Binding SkipOperationCommand}" IsVisible="{Binding CanSkipOperation}" />
            <Button Content="Abort" Command="{Binding AbortOperationCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding OperationBanner}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="6">
        <TextBox Grid.Column="0" Text="{Binding SearchText}"
                 Watermark="Search message, author, SHA or branch" />
        <Button Grid.Column="1" Content="&#x25B2;" Command="{Binding PreviousMatchCommand}" ToolTip.Tip="Previous match" />
        <Button Grid.Column="2" Content="&#x25BC;" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next match" />
        <TextBlock Grid.Column="3" Text="{Binding SearchSummary}" VerticalAlignment="Center" Opacity="0.7" />
        <ToggleButton Grid.Column="4" Content="Working directory"
                      IsChecked="{Binding ShowWorkingDirectory, Mode=TwoWay}" />
      </Grid>
      </StackPanel>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
        <ctl:CommitGraphControl Graph="{Binding Graph}"
                                RefsByCommit="{Binding RefsByCommit}"
                                MatchedShas="{Binding MatchedShas}"
                                MenuProvider="{Binding MenuProvider}"
                                SelectedRow="{Binding SelectedRow, Mode=TwoWay}" />
      </ScrollViewer>

      <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" />

      <!-- Details / working directory + diff -->
      <Grid Grid.Row="3" ColumnDefinitions="320,Auto,*">
        <!-- Pull request detail mode -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8"
              IsVisible="{Binding HasPullRequestDetail}">
          <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{Binding PullRequestDetailTitle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Checkout" Command="{Binding CheckoutPullRequestCommand}" Margin="0,0,6,6" />
              <Button Content="&#x2714; Approve" Command="{Binding ApprovePullRequestCommand}" Background="#2E7D32" Margin="0,0,6,6" />
              <Button Content="Request changes" Command="{Binding RequestPullRequestChangesCommand}" Background="#E65100" Margin="0,0,6,6" />
              <Button Content="Comment" Command="{Binding CommentOnPullRequestCommand}" Margin="0,0,6,6" />
              <Button Content="Merge" Command="{Binding MergePullRequestCommand}" Background="#6A1B9A" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding PullRequestDetail.Description}" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding PullRequestDetailSummary}" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Text="Checks" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding PullRequestStatusChecks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:PullRequestStatusCheck">
                  <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding Status}" Width="90" Opacity="0.7" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Commits" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding PullRequestCommits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:PullRequestCommit">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.65" Text="{Binding Sha, StringFormat='{}{0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Threads" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding PullRequestThreads}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:PullRequestThread">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Anchor.Path}" Opacity="0.65"
                               IsVisible="{Binding Anchor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Comments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PullRequestComment">
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Author}" />
                            <Run Text=": " />
                            <Run Text="{Binding Body}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Changed files" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:ChangedFile">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Status}" Opacity="0.6" Width="60" />
                  <TextBlock Text="{Binding Path}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Commit mode -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8"
              IsVisible="{Binding ShowCommitMode}">
          <StackPanel Grid.Row="0" Spacing="4"
                      IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedRow.Commit.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRow.Commit.Sha}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                       Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Opacity="0.7">
              <Run Text="{Binding SelectedRow.Commit.AuthorName}" />
              <Run Text="  " />
              <Run Text="{Binding SelectedRow.Commit.When}" />
            </TextBlock>
            <TextBlock Text="Changed files" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
          <TextBlock Grid.Row="0" Text="{Binding DetailHeading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"
                     IsVisible="{Binding DetailHeading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:ChangedFile">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Status}" Opacity="0.6" Width="60" />
                  <TextBlock Text="{Binding Path}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Working directory mode -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,*,Auto" Margin="8"
              IsVisible="{Binding ShowWorkingDirectory}">
          <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="Stage all" Command="{Binding StageAllCommand}" />
            <TextBlock Text="Unstaged" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Unstaged}" SelectedItem="{Binding SelectedUnstaged}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:FileChange">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="+" Padding="6,0"
                          ToolTip.Tip="Stage file"
                          Command="{Binding $parent[UserControl].((vm:RepoTabViewModel)DataContext).StageFileCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Status}" Opacity="0.6" Width="64" Margin="0,0,8,0" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Unstage all" Command="{Binding UnstageAllCommand}" />
            <TextBlock Text="Staged" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding Staged}" SelectedItem="{Binding SelectedStaged}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:FileChange">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="&#x2212;" Padding="6,0"
                          ToolTip.Tip="Unstage file"
                          Command="{Binding $parent[UserControl].((vm:RepoTabViewModel)DataContext).UnstageFileCommand}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Status}" Opacity="0.6" Width="64" Margin="0,0,8,0" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="4" Spacing="4">
            <TextBox Text="{Binding CommitMessage}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     Watermark="Commit message" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Commit" Command="{Binding CommitCommand}" />
              <CheckBox Content="Amend last commit" IsChecked="{Binding Amend}" />
            </DockPanel>
            <TextBlock Text="{Binding WorkingTreeSummary}" Opacity="0.6" FontSize="11" />
          </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" />

        <!-- Diff -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*"
              IsVisible="{Binding ActiveConflict, Converter={x:Static ObjectConverters.IsNull}}">
          <DockPanel Grid.Row="0" Margin="6,4">
            <ToggleButton DockPanel.Dock="Right" Content="Side by side" Margin="6,0,0,0"
                          IsChecked="{Binding SideBySide, Mode=TwoWay}" />
              <Button DockPanel.Dock="Right" Content="Comment selection" Margin="6,0,0,0"
                Command="{Binding AddInlinePullRequestCommentCommand}"
                IsVisible="{Binding CanCommentSelectedPullRequestInline}" />
            <Button DockPanel.Dock="Right" Content="Blame" Margin="6,0,0,0"
                    Command="{Binding ShowBlameCommand}" IsEnabled="{Binding HasCurrentFile}" />
            <Button DockPanel.Dock="Right" Content="History" Margin="6,0,0,0"
                    Command="{Binding ShowHistoryCommand}" IsEnabled="{Binding HasCurrentFile}" />
            <Button DockPanel.Dock="Right" Content="{Binding SelectionActionText}"
                    Command="{Binding StageSelectedCommand}" IsVisible="{Binding DiffEditable}" />
            <TextBlock Text="{Binding ActiveDiff.Path}" VerticalAlignment="Center" Opacity="0.8"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ctl:DiffView Grid.Row="1"
                        Diff="{Binding ActiveDiff}"
                        SideBySide="{Binding SideBySide}"
                        Editable="{Binding DiffEditable}"
                        Staged="{Binding DiffStaged}"
                        Selection="{Binding Selection}"
                        HunkCommand="{Binding ApplyHunkCommand}" />
        </Grid>

        <!-- 3-way conflict resolution -->
        <Border Grid.Column="2" IsVisible="{Binding ActiveConflict, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ctl:ConflictView DataContext="{Binding ActiveConflict}" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
