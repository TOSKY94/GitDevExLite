<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDevExLite.App.ViewModels"
        xmlns:ctl="using:GitDevExLite.App.Controls"
        xmlns:s="using:GitDevExLite.Core.Services"
        x:Class="GitDevExLite.App.Views.FileHistoryWindow"
        x:DataType="vm:FileHistoryViewModel"
        Title="File history" Width="1100" Height="700"
        WindowStartupLocation="CenterOwner">
  <TabControl x:Name="Tabs">
    <TabItem Header="History">
      <Grid ColumnDefinitions="340,Auto,*">
        <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="6">
          <ListBox Grid.Row="0" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="s:FileHistoryEntry">
                <StackPanel>
                  <TextBlock Text="{Binding Commit.Summary}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.6">
                    <TextBlock Text="{Binding Commit.ShortSha}" FontFamily="Consolas,Menlo,monospace" />
                    <TextBlock Text="{Binding Commit.AuthorName}" />
                    <TextBlock Text="{Binding Commit.When, StringFormat={}{0:yyyy-MM-dd}}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,6,0,0">
            <TextBlock Text="{Binding HistoryError}" TextWrapping="Wrap" Foreground="OrangeRed" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Show in graph" Command="{Binding GoToHistoryCommitCommand}" />
              <Button Content="Blame at this commit" Command="{Binding BlameAtSelectedCommitCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="4" />
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
          <DockPanel Margin="6,4">
            <ToggleButton DockPanel.Dock="Right" Content="Side by side" IsChecked="{Binding SideBySide, Mode=TwoWay}" />
            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ctl:DiffView Grid.Row="1" Diff="{Binding ActiveDiff}" SideBySide="{Binding SideBySide}" />
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Blame">
      <Grid RowDefinitions="Auto,*,Auto" Margin="6">
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="Blame at HEAD" Command="{Binding BlameAtHeadCommand}" />
          <TextBlock VerticalAlignment="Center">
            <Run Text="Blame of " /><Run Text="{Binding Path}" FontWeight="SemiBold" /><Run Text=" at " /><Run Text="{Binding BlameRevision}" />
          </TextBlock>
        </DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding BlameLines}" SelectedItem="{Binding SelectedBlame}"
                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="s:BlameLine">
              <Grid ColumnDefinitions="44,64,130,*">
                <TextBlock Grid.Column="0" Text="{Binding LineNumber}" Opacity="0.5" />
                <TextBlock Grid.Column="1" Text="{Binding ShortSha}" Foreground="#8AB4F8" />
                <TextBlock Grid.Column="2" Text="{Binding Author}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Text}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Content="Show in graph" Command="{Binding GoToBlameCommitCommand}" />
          <TextBlock Text="{Binding BlameDetail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
